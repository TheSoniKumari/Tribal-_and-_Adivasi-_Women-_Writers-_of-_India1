const directory=document.getElementById('directory');
const search=document.getElementById('search');
const language=document.getElementById('language');
const state=document.getElementById('state');
[...new Set(profiles.map(p=>p.language))].sort().forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;language.append(o)});
[...new Set(profiles.map(p=>p.state))].sort().forEach(v=>{const o=document.createElement('option');o.value=v;o.textContent=v;state.append(o)});
function render(){
 const q=search.value.trim().toLowerCase(),l=language.value,s=state.value;
 const list=profiles.filter(p=>(!l||p.language===l)&&(!s||p.state===s)&&(!q||[p.name,p.language,p.community,p.role,p.bio,p.state].join(' ').toLowerCase().includes(q)));
 document.getElementById('count').textContent=profiles.length;
 document.getElementById('result-count').textContent=`Showing ${list.length} of ${profiles.length} verified profiles`;
 directory.innerHTML='';
 if(!list.length){directory.innerHTML='<div class="empty">No matching profile. Try another search or filter.</div>';return}
 list.forEach(p=>{
  const card=document.createElement('article');card.className='card';
  const initials=p.name.split(/\s+/).map(x=>x[0]).slice(0,2).join('');
  const links=p.sources.map(s=>`<a href="${s[1]}" target="_blank" rel="noopener">${s[0]} ↗</a>`).join('');
  card.innerHTML=`<div class="card-top"><div class="initial" aria-hidden="true">${initials}</div><span class="status">Source-linked</span></div><h3></h3><div class="sub"></div><p class="small"></p><p class="bio"></p><div class="card-bottom"><div class="links">${links}</div></div>`;
  card.querySelector('h3').textContent=p.name;
  card.querySelector('.sub').textContent=p.role;
  card.querySelector('.small').textContent=`Language: ${p.language} · Community: ${p.community} · State: ${p.state}`;
  card.querySelector('.bio').textContent=p.bio;
  directory.append(card);
 });
}
search.addEventListener('input',render);language.addEventListener('change',render);state.addEventListener('change',render);render();
</script>
